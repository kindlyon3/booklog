---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import { url } from "../lib/books";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = "A month-by-month log of books read." } = Astro.props;
const pageTitle = title ? `${title} · booklog` : "booklog";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url("apple-touch-icon.png")} />
    <title>{pageTitle}</title>
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme");
        if (theme) document.documentElement.dataset.theme = theme;
      } catch {
        // Storage blocked; fall back to the system theme.
      }
    </script>
  </head>
  <body>
    <header>
      <a class="site-title" href={url()}>
        booklog
      </a>
      <nav aria-label="Main">
        <a class="label" href={url()}>
          Books
        </a>
        <a class="label" href={url("authors/")}>
          Authors
        </a>
        <ThemeToggle />
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="meta">
      Book details and covers from <a href="https://openlibrary.org">Open Library</a>.
    </footer>
  </body>
</html>

<style>
  header,
  main,
  footer {
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: var(--space-3);
  }

  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--rule);
  }

  .site-title {
    font-size: 1.75rem;
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  nav a {
    text-decoration: none;
  }

  main {
    padding-block: var(--space-4);
  }

  footer {
    padding-block: var(--space-4) var(--space-5);
    border-top: 1px solid var(--rule);
  }
</style>
