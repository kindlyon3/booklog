---
import type { Book } from "../lib/books";
import { fold } from "../lib/slugify";
import Byline from "./Byline.astro";
import Cover from "./Cover.astro";
import Stars from "./Stars.astro";

interface Props {
  book: Book;
}

const { book } = Astro.props;
const details = [book.published, book.pages && `${book.pages} pp`, book.form].filter(Boolean);
---

<li
  class="book"
  data-year={book.finished?.slice(0, 4)}
  data-form={book.form}
  data-rating={book.rating ?? 0}
  data-search={fold(`${book.title} ${book.authors.join(" ")}`)}
>
  <Cover book={book} />
  <div class="text">
    <p class="title">
      {book.title}
      {book.edition && <span class="edition">({book.edition})</span>}
    </p>
    <Byline book={book} />
    <p class="meta">{details.join(" · ")}</p>
    {book.note && <p class="note">{book.note}</p>}
  </div>
  {book.rating && <Stars rating={book.rating} id={book.id} />}
</li>

<style>
  .book {
    display: grid;
    grid-template-columns: var(--cover-width) minmax(0, 1fr) auto;
    gap: var(--space-2) var(--space-3);
    align-items: start;
    padding-block: var(--space-3);
  }

  .book + .book {
    border-top: 1px dashed var(--rule);
  }

  .book > :global(.cover) {
    grid-row: span 2;
  }

  .title {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .edition {
    font-weight: 400;
    font-style: italic;
    color: var(--muted);
  }

  .meta,
  .note {
    margin: var(--space-1) 0 0;
  }

  .note {
    font-style: italic;
    font-size: 0.9rem;
  }

  @media (max-width: 30rem) {
    .book {
      grid-template-columns: var(--cover-width) minmax(0, 1fr);
    }

    .book > :global(.stars) {
      grid-column: 2;
    }
  }
</style>
